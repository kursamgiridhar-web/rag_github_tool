# Copy to backend/.env and fill in. NEVER commit the real .env file.

PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
MONGODB_DB=repo_investigator

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is out of quota (429) or overloaded (503)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding vector size; must match the Atlas Vector Search index
EMBEDDING_DIMENSIONS=768

# Optional: raises GitHub API rate limit (public repos only need read access)
GITHUB_TOKEN=

# Optional import limits
# MAX_FILES=120
# MAX_CHUNKS=500
